APP_NAME="Uzbek Local Voice AI"
OFFLINE_MODE="false"
DATABASE_URL="file:./dev.db"
AI_SERVICE_HOST="127.0.0.1"
AI_SERVICE_PORT="8001"
AI_SERVICE_URL="http://127.0.0.1:8001"
LLM_BACKEND="llama.cpp"
LLM_MODEL_PATH="./models/llm/model.gguf"
LLM_CONTEXT_SIZE="8192"
LLM_GPU_LAYERS="-1"
LLM_THREADS="8"
LLM_BATCH_SIZE="512"
LLM_TEMPERATURE="0.4"
LLM_TOP_P="0.9"
LLM_MAX_TOKENS="700"
STT_MODEL_PATH="./models/stt/fastconformer"
STT_LANGUAGE="uz"
TTS_MODEL_PATH="./models/tts/uzbek-voice"
TTS_BASE_MODEL_PATH="./models/tts/qwen3-tts-base"
TTS_LANGUAGE="uz"
TTS_DEFAULT_SPEAKER="default"
EMBEDDING_MODEL_PATH="./models/embeddings/model"
MAX_RECORDING_SECONDS="120"
AUDIO_RETENTION_HOURS="24"
AUTO_PLAY_ASSISTANT_AUDIO="true"
